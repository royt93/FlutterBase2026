<?xml version="1.0" encoding="utf-8"?>
<!--
  T228 — reference layout for T228CustomNativeAdFactory.kt. Adapted from
  google_mobile_ads' own example/android/.../my_native_ad.xml reference
  layout, trimmed to the assets this demo actually binds.

  t228_ad_choices (AdChoicesView) is the mandatory attribution icon —
  required by Google's native-ad policy in every custom layout, not
  optional chrome.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="T228 custom NativeAdFactory">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="#FFFFFF"
      android:orientation="vertical"
      android:padding="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal">

        <ImageView
            android:id="@+id/t228_ad_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

          <TextView
              android:id="@+id/t228_ad_headline"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textSize="16sp"
              android:textStyle="bold" />

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal">

            <TextView
                android:id="@+id/t228_ad_advertiser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp" />

            <RatingBar
                android:id="@+id/t228_ad_stars"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:isIndicator="true"
                android:numStars="5"
                android:stepSize="0.5" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>

      <com.google.android.gms.ads.nativead.AdChoicesView
          android:id="@+id/t228_ad_choices"
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:layout_gravity="top|end" />
    </FrameLayout>

    <TextView
        android:id="@+id/t228_ad_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp" />

    <com.google.android.gms.ads.nativead.MediaView
        android:id="@+id/t228_ad_media"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/t228_ad_call_to_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />
  </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
